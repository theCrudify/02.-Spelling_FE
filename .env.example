# Backend base URL (server-side only, never exposed to the browser)
API_URL=http://localhost:4100

# Dev only: shows a working "login as admin" button. Never set on a shared or deployed server.
ENABLE_DEV_BYPASS=false

# Demo shortcuts on the login page: comma separated NIKs + their shared password. Leave empty on a real server.
DEMO_ACCOUNTS=
DEMO_PASSWORD=
